# ---------------------------------------------------------------
# Crypto Auto-Trading Bot - Environment Variables
# ---------------------------------------------------------------
# 이 파일을 복사해서 .env 파일을 만드세요: cp .env.example .env
# .env 파일은 절대 git에 커밋하지 마세요 (.gitignore에 포함되어 있음).
# ---------------------------------------------------------------

# 거래소 API 키 (Binance / Upbit 공통)
# - 학습 단계에서는 Binance Testnet 사용: https://testnet.binance.vision
# - Binance 실전 키는 "Spot Trading"만 허용하고 "Withdrawal"은 반드시 비활성화
# - Upbit 키는 "자산 조회 / 주문" 만 허용하고 "출금"은 반드시 비활성화
#   + IP 화이트리스트 설정 권장
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=

# Telegram Notification (선택, Phase 3에서 사용)
# 1. Telegram 에서 @BotFather 검색 → /newbot → 봇 이름 입력 → 토큰 발급
# 2. 생성한 봇과 대화 시작(아무 메시지 전송)
# 3. 브라우저에서 https://api.telegram.org/bot<TOKEN>/getUpdates 접속
# 4. 응답 JSON의 "chat":{"id": 숫자} 에서 chat_id 확인
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
